ner {\r\n        fun onCheckChange(\r\n            fixture: Fixtures.Response,\r\n            isChecked: Boolean,\r\n            action: String\r\n        )\r\n\r\n        fun checkNotificationPermission(\r\n            fixture: Fixtures.Response,\r\n            isChecked: Boolean,\r\n        ): Boolean\r\n    }\r\n}
