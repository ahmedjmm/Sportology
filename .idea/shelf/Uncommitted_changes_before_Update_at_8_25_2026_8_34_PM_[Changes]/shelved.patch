sult(\r\n        @Query(\"search\")\r\n        query: String\r\n    ): Response<TeamSearchResult>\r\n\r\n    @GET(\"/leagues\")\r\n    suspend fun getLeagueSearchResult(\r\n        @Query(\"search\")\r\n        query: String\r\n    ): Response<LeagueSearchResult>\r\n\r\n    @GET(\"/coachs\")\r\n    suspend fun getCoaches(\r\n        @Query(\"team\")\r\n        teamId: Int\r\n    ): Response<Coachs>\r\n}
